@model ThermalFlowAnalyzer.Domain.AnalysisInput

<h3 class="mb-3">🧮 Новый тепловой анализ</h3>

<div class="card p-4">

    <form method="post">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>


        <div class="row">
            <div class="col-md-4">
                <label>Название проекта</label>
                <input asp-for="ProjectTitle" class="form-control" />
            </div>

            <div class="col-md-4">
                <label>Высота слоя, м</label>
                <input asp-for="LayerHeight" type="number" step="0.5" class="form-control" />
            </div>

            <div class="col-md-4">
                <label>Диаметр колонны, м</label>
                <input asp-for="ColumnDiameter" type="number" step="0.1" class="form-control" />
            </div>
        </div>

        <hr />

        <div class="row">
            <div class="col-md-3">
                <label>T материала, °C</label>
                <input asp-for="SolidTempStart" class="form-control" />
            </div>
            <div class="col-md-3">
                <label>T газа, °C</label>
                <input asp-for="GasTempStart" class="form-control" />
            </div>
            <div class="col-md-3">
                <label>Скорость газа</label>
                <input asp-for="GasSpeed" class="form-control" />
            </div>
            <div class="col-md-3">
                <label>αV</label>
                <input asp-for="HeatTransferFactor" class="form-control" />
            </div>
        </div>

        <hr />

        <div class="row">
            <div class="col-md-4">
                <label>Расход материала</label>
                <input asp-for="SolidFlow" class="form-control" />
            </div>
            <div class="col-md-4">
                <label>Теплоемкость материала</label>
                <input asp-for="SolidHeatCapacity" class="form-control" />
            </div>
            <div class="col-md-4">
                <label>Теплоемкость газа</label>
                <input asp-for="GasHeatCapacity" class="form-control" />
            </div>
        </div>

        <button class="btn btn-main mt-4 px-5">
            ▶ Запустить анализ
        </button>

    </form>
</div>
