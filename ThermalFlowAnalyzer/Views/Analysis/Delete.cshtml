@model ThermalFlowAnalyzer.Domain.AnalysisInput

<h3 class="text-danger">❌ Удаление анализа</h3>

<div class="card p-4">
    <p>
        Вы действительно хотите удалить анализ
        <b>@Model.ProjectTitle</b>?
    </p>

    <form method="post" action="/Analysis/DeleteConfirmed/@Model.Id">
        <button class="btn btn-danger">Удалить</button>
        <a class="btn btn-secondary" href="/Analysis/Dashboard">Отмена</a>
    </form>
</div>
